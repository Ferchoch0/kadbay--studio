{
    "name": "otterly/stetic-api",
    "description": "REST API for Estudio de Belleza - Stetic (MySQLi + XAMPP)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^7.0",
        "google/apiclient": "^2.20",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "serve": "php -S 0.0.0.0:8000 -t public/",
        "migrate": "php scripts/migrate.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
