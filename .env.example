# URL base de la stetic-api
NEXT_PUBLIC_API_URL=http://localhost:8080

# Slug del negocio en la tabla `businesses`
# La API lo resuelve a business_id internamente
# En producción, el slug debe coincidir con el campo `slug` del negocio en la DB
# kadbay usa el slug "kadbay" (custom_domain: http://localhost:3000)
NEXT_PUBLIC_BUSINESS_SLUG=kadbay

# Google OAuth Client ID (opcional, para login con Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
